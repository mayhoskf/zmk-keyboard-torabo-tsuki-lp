#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans          &trans        &trans        &trans  &trans  &trans                            &trans     &trans  &trans     &trans           &trans     &trans
&kp ESCAPE      &kp Q         &kp W         &kp E   &kp R   &kp T                             &kp Y      &kp U   &kp I      &kp O            &kp P      &kp BSPC
&kp TAB         &kp A         &kp S         &kp D   &kp F   &kp G   &trans         &trans     &kp H      &kp J   &kp K      &kp L            &kp SEMI   &kp ENTER
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C   &kp V   &kp B   &kp LA(GRAVE)  &kp LANG5  &kp N      &kp M   &kp COMMA  &kp DOT          &kp SLASH  &none
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &none   &mo 1   &mo 2   &mo 3          &kp ENTER  &kp SPACE  &trans  &trans     &kp RIGHT_SHIFT  &none      &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans            &trans            &trans      &trans      &trans                         &trans      &trans      &trans         &trans             &trans             &trans
&none   &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                     &kp LS(N6)  &kp LS(N7)  &kp LS(N8)     &kp LS(N9)         &kp LS(N0)         &kp BACKSPACE
&none   &kp N1            &kp N2            &kp N3      &kp N4      &kp N5      &trans  &trans     &none       &none       &kp LS(MINUS)  &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp ENTER
&none   &kp N6            &kp N7            &kp N8      &kp N9      &kp N0      &none   &none      &none       &none       &kp LS(EQUAL)  &kp LEFT_BRACE     &kp RIGHT_BRACE    &none
&none   &none             &none             &none       &none       &none       &none   &kp ENTER  &kp SPACE   &trans      &trans         &kp LS(BACKSLASH)  &none              &none
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&none   &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &trans  &trans  &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            >;
        };

        layer_3_mouse {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                       &trans  &trans     &trans            &trans     &trans  &trans
&none   &none   &kp F1  &kp F2   &kp F3   &kp F4                       &none   &none      &msc MOVE_Y(5)    &none      &none   &none
&none   &none   &kp F5  &kp F6   &kp F7   &kp F8   &trans      &trans  &none   &mkp LCLK  &mkp MCLK         &mkp RCLK  &none   &none
&none   &none   &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_NXT  &none   &none   &none      &msc MOVE_Y(-10)  &none      &none   &none
&none   &none   &none   &none    &none    &none    &none       &none   &none   &none      &none             &none      &none   &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&none   &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &trans  &trans  &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            >;
        };
    };
};
